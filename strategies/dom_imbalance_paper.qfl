-- DOM imbalance paper strategy.
-- Intended for `quince replay` / QUINCE_SHADOW only: it emits paper order
-- intents so replay can demonstrate top-of-book fills, fees and slippage.

@exchange binance
@network mainnet

@persist in_long : i64 = 0
@persist bid_streak : i64 = 0
@persist ask_streak : i64 = 0
@persist cooldown : i64 = 0

on depth(d) {
    let bid_liquidity = quince.depth_bid(0) + quince.depth_bid(1) + quince.depth_bid(2)
    let ask_liquidity = quince.depth_ask(0) + quince.depth_ask(1) + quince.depth_ask(2)

    if bid_liquidity <= 0.0 or ask_liquidity <= 0.0 {
        return
    }

    if cooldown > 0 {
        cooldown = cooldown - 1
        return
    }

    if bid_liquidity > ask_liquidity * 1.60 {
        bid_streak = bid_streak + 1
        ask_streak = 0
    } elseif ask_liquidity > bid_liquidity * 1.40 {
        ask_streak = ask_streak + 1
        bid_streak = 0
    } else {
        bid_streak = 0
        ask_streak = 0
    }

    if in_long == 0 and bid_streak >= 3 {
        quince.order(0, 0.01, 0)
        in_long = 1
        bid_streak = 0
        cooldown = 15
        quince.log("dom_imbalance_paper: long")
    }

    if in_long > 0 and ask_streak >= 2 {
        quince.order(1, 0.01, 0)
        in_long = 0
        ask_streak = 0
        cooldown = 15
        quince.log("dom_imbalance_paper: exit")
    }
}
